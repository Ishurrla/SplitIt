rules_version = '2';

// Proven by tests/rules/firestore.rules.test.ts (run: pnpm test:rules). Not deployed: the
// project runs on the emulators only.
//
// The idea in one line: clients may READ what belongs to groups they are in, and may WRITE only
// their own profile. Everything else (groups, members, expenses, payments, activity, invites) is
// written by callable Cloud Functions through the Admin SDK, which bypasses these rules and
// re-checks membership, amounts and splits itself.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(gid) {
      return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid);
    }

    // One document read. The member document id is the uid, so we can check it with exists().
    function isMember(gid) {
      return isSignedIn() && exists(memberDoc(gid));
    }

    // One document read (get). Only true when the member document says role == 'owner'.
    function isOwner(gid) {
      return isSignedIn() && get(memberDoc(gid)).data.role == 'owner';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- users/{uid} ----------
    // Readable only by the person themselves. Other members' names and photos are copied onto
    // groups/{gid}/members/{uid} by a function, so the group screens never need to read
    // someone else's users document (and their email stays private).

    function validCurrency(c) {
      return c in ['NGN', 'USD', 'GBP', 'EUR', 'GHS', 'KES', 'ZAR', 'CAD', 'JPY'];
    }

    function validDisplayName(n) {
      return n is string && n.size() >= 1 && n.size() <= 60;
    }

    // Fields a client may change directly after creation. displayName and photoPath are NOT here:
    // they are copied onto every members document, so they change only through the updateProfile
    // callable, which updates users/{uid} and all the copies together. email, photoURL and
    // createdAt never change.
    function editableUserFields() {
      return ['defaultCurrency', 'weeklyReminders'];
    }

    match /users/{uid} {
      allow read: if isSelf(uid);

      // Created by the client on first sign-in. email and photoURL must match the auth token,
      // so nobody can claim someone else's email or picture. No uploaded photo exists yet.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'photoPath', 'defaultCurrency', 'weeklyReminders', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['displayName', 'email', 'photoURL', 'photoPath', 'defaultCurrency', 'weeklyReminders', 'createdAt'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photoURL == request.auth.token.get('picture', null)
        && request.resource.data.photoPath == null
        && validCurrency(request.resource.data.defaultCurrency)
        && request.resource.data.weeklyReminders is bool
        && request.resource.data.createdAt == request.time;

      // Field allow-list: only the editable fields may change, and each must stay valid.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableUserFields())
        && validCurrency(request.resource.data.defaultCurrency)
        && request.resource.data.weeklyReminders is bool;

      allow delete: if false;
    }

    // ---------- groups/{gid} and everything under it ----------

    match /groups/{gid} {
      // Checked with memberIds, not isMember(): the Groups page runs the query
      // where('memberIds', 'array-contains', uid), and Firestore can only allow a query when the
      // rule can be proved from the query itself. memberIds is on the document, so this costs no
      // extra reads. Functions keep memberIds and the members subcollection in step, in one transaction.
      // If the group does not exist, resource is null, the rule errors and the read is denied,
      // exactly as for a group you are not in. The UI cannot tell the two apart.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false; // createGroup, leaveGroup, removeMember, and money callables only

      match /members/{uid} {
        allow read: if isMember(gid);
        // createGroup, acceptInvite, leaveGroup, removeMember, and updateProfile for the copied
        // displayName / photoPath. A client must never write here: it could promote itself to owner.
        allow write: if false;
      }

      match /expenses/{eid} {
        allow read: if isMember(gid);
        allow write: if false; // saveExpense, deleteExpense
      }

      match /payments/{pid} {
        allow read: if isMember(gid);
        allow write: if false; // recordPayment. Payments are never edited or deleted.
      }

      match /activity/{aid} {
        allow read: if isMember(gid);
        allow write: if false; // written by functions in the same transaction as the change
      }
    }

    // ---------- invites/{token} ----------
    // The document id is the secret token. Only the group's owner may read invites (to list
    // pending ones, with a query filtered by groupId). People with a link never read this
    // collection: the join screen calls invitePreview(token), which returns only the group
    // name and the inviter's name.
    match /invites/{token} {
      allow read: if isOwner(resource.data.groupId);
      allow write: if false; // createInvite, acceptInvite
    }

    // No collection-group rule for activity: the Activity page reads each of my groups'
    // activity subcollections separately, so every read is covered by isMember(gid) above.

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
