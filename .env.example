# Copy to .env.local for local development. Never commit .env.local.
#
# VITE_* values are the Firebase web config. They are public (they ship to every browser) and
# only identify the project; Auth and the security rules decide what anyone can do.

# With the emulators, the demo project id is enough; the other values can stay as they are.
VITE_FIREBASE_PROJECT_ID=demo-splitit
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-splitit.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app-id
# Only used for photo uploads, which only the emulators have.
VITE_FIREBASE_STORAGE_BUCKET=demo-splitit.appspot.com

# true: connect Auth and Firestore to the local emulators, and run the API (/api, served by
# pnpm dev from server/) against them too.
VITE_USE_EMULATORS=true
# true: offer receipt, cover and profile photo uploads (Storage emulator). Leave unset on Vercel:
# Firebase Storage needs the paid plan, so the live site has no uploads.
VITE_STORAGE_UPLOADS=true

# ---- Server only (no VITE_ prefix, so never sent to the browser) ----
# The API's Admin SDK credentials for a real project: the service-account key JSON, base64.
# Set it only in Vercel's environment variables (README, "Deploying"). Leave it empty here:
# with VITE_USE_EMULATORS=true the API uses the emulators instead.
FIREBASE_SERVICE_ACCOUNT=
# Optional: calls per person per minute, per server instance (default 120).
API_RATE_LIMIT_PER_MINUTE=
