# Copy to .env.local. These values are public (the Firebase web config ships to every browser).
# Never put a service account key here or anywhere in the client.

# With the emulators, the demo project id is enough; the other values can stay as they are.
VITE_FIREBASE_PROJECT_ID=demo-splitit
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-splitit.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-splitit.appspot.com
VITE_FIREBASE_APP_ID=demo-app-id

# true: connect Auth, Firestore, Storage and Functions to the local emulators.
VITE_USE_EMULATORS=true
