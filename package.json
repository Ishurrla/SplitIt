{
  "name": "splitit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-splitit --only \"firestore,storage\" \"vitest run --config vitest.rules.config.ts\"",
    "test:api": "firebase emulators:exec --project demo-splitit --only \"auth,firestore,storage\" \"vitest run --config vitest.api.config.ts\"",
    "emulators": "firebase emulators:start --project demo-splitit",
    "seed": "node scripts/seed.mjs",
    "demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/demo-walkthrough.ps1",
    "diagram": "pnpm dlx @mermaid-js/mermaid-cli -i docs/data-model.mmd -o docs/data-model.png -b white -t neutral -s 2 -p docs/puppeteer.json"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
